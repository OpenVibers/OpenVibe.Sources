# ═══════════════════════════════════════════════════════════════
# OpenVibe.Sources — Environment Configuration
# Copy to .env and fill in values.
# In production this lives at /etc/openvibe/sources.env (0600); the systemd unit sets
# NODE_ENV, PORT and SOURCES_DB_PATH itself.
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4720
HOST=127.0.0.1
NODE_ENV=development
#BASE_URL=https://sources.openvibe.network

# Identity — OpenVibe.Network signs the service tokens (audience openvibe.sources) callers present.
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
#OV_NETWORK_ISSUER=https://openvibe.network
#OV_NETWORK_PUBLIC_KEY=

# This service's own principal (svc:sources) — publishes sources.* events (events.event.publish).
OV_OAUTH_CLIENT_ID=sources
OV_OAUTH_CLIENT_SECRET=

# Store (SQLite). Production: /var/lib/openvibe-sources/sources.db (systemd StateDirectory).
SOURCES_DB_PATH=./data/sources.db

# OpenVibe.Events. The outbox relay runs only when EVENTS_URL is set.
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_RELAY_INTERVAL_MS=2000

# Ingestion worker (in-process scheduler)
#SOURCES_WORKER=on
#SOURCES_TICK_MS=5000
#SOURCES_MAX_CONCURRENT=4
#SOURCES_MAX_BACKOFF_MS=21600000

# Fetching
#SOURCES_USER_AGENT=OpenVibeSources/0.1.0 (+https://sources.openvibe.network; Contact@OpenVibe.Network)
#SOURCES_ROBOTS_AGENT=OpenVibeSources
#SOURCES_FETCH_TIMEOUT_MS=20000
#SOURCES_MAX_BYTES=5242880
#SOURCES_MAX_REDIRECTS=5
#SOURCES_ROBOTS_TTL_MS=86400000
# Least time between two requests to one host, whatever a source says.
#SOURCES_HOST_MIN_INTERVAL_MS=1000
#SOURCES_ALLOWED_PORTS=80,443
# Exact hosts/IPs allowed to resolve to private/loopback addresses. Leave EMPTY in production.
#SOURCES_ALLOW_PRIVATE_HOSTS=
#SOURCES_MAX_ITEMS_PER_FETCH=500

# Source credentials: a registry entry names the variable (auth.env), never the value. Names
# must start with SOURCES_CRED_. Example (none of the seeds needs one):
#SOURCES_CRED_EXAMPLE_API_KEY=
